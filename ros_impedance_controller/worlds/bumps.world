<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <physics type='ode'>
      <gravity>0 0 -9.81</gravity>
      <!-- max step size has to be a multiple of the desired task rate-->
      <max_step_size>0.001</max_step_size> 
      <real_time_factor>1</real_time_factor>
    </physics>
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <name>b1</name>
      <uri>model://sphere_05</uri>
      <pose>0.40 1.5 -0.4 0 0 0</pose>
    </include>

    <include>
      <name>b2</name>
      <uri>model://sphere_05</uri>
      <pose>-0.40 3 -0.4 0 0 0</pose>
    </include>

    <include>
      <name>b-bis-1</name>
      <uri>model://sphere</uri>
      <pose>-0.55 5 -0.90 0 0 0</pose>
    </include>

    <include>
      <name>b-bis-2</name>
      <uri>model://sphere</uri>
      <pose>0.55 5 -0.90 0 0 0</pose>
    </include>

    <include>
      <name>cylinder</name>
      <uri>model://cylinder</uri>
      <pose>0 7 -0.15 0 1.57 0</pose>
    </include>

    <include>
      <name>ramp</name>
      <uri>model://ramp_15</uri>
      <pose>0 10 0 0 0 -1.57</pose>
    </include>

  </world>
</sdf>

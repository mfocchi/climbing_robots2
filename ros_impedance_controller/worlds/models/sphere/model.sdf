<?xml version="1.0" ?>
<sdf version="1.4">

<model name="sphere">
	<static>true</static>
		<link name="link">

		<collision name="collision">
			<geometry>
				<sphere>
					<radius>1</radius>
				</sphere>
			</geometry>
		</collision>

		<visual name="visual">
			<geometry>
				<sphere>
					<radius>1</radius>
				</sphere>
			</geometry>
		</visual>
	</link>
</model>

</sdf>

